      "id": "a609844e-4e78-4bf4-90aa-a793795eedad",
      "name": "Buscar Tracking Regua Implantacao",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        224,
        768
      ],
      "alwaysOutputData": true,
