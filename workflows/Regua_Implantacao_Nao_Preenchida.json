    {
      "name": "ML_02_processar_parciais",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        900
      ],
      "parameters": {
        "jsCode": "// multi-loja 21/09/2026: lembrete de lojas faltantes (preenchimento parcial)\n// Reaproveita o mesmo intervalo do 1o lembrete da regua (2 dias) e o mesmo limite de tentativas do projeto (3) antes de escalar.\nconst DIAS_LEMBRETE = 2;\nconst MAX_TENTATIVAS = 3;\nconst dig = v => String(v || '').replace(/\\D/g, '');\nconst logs = $('Buscar Log Implantacao Pendente').all().map(i => i.json);\nconst baseFunil = $('Buscar Base Funil Completo').all().map(i => i.json);\nconst tracking = $('Buscar Tracking Regua Implantacao').all().map(i => i.json);\nconst lojas = $('ML_01_busca_lojas_implantacao').all().map(i => i.json).filter(r => r && r.lead_id);\nconst basePorLeadId = new Map(baseFunil.map(l => [String(l.lead_id), l]));\nconst trackingPorDeal = new Map(tracking.map(t => [String(t.deal_id), t]));\nconst agora = new Date();\nconst saida = [];\nfor (const log of logs) {\n  if (!log || !log.deal_id) continue;\n  if (log.concluido && String(log.concluido).trim() !== '') continue;\n  const dealId = String(log.deal_id);\n  const lead = basePorLeadId.get(dealId);\n  if (!lead) continue;\n  const esperadas = Math.max(1, Number(dig(lead.quantidade_lojas)) || 1);\n  if (esperadas <= 1) continue; // 1 loja: comportamento padrao da regua (ramo existente)\n  const linhas = lojas.filter(r => String(r.lead_id) === dealId);\n  const cnpjs = [...new Set(linhas.map(r => dig(r.cnpj_loja)).filter(Boolean))];\n  const preenchidas = cnpjs.length;\n  if (preenchidas === 0) continue;          // 0 lojas: ramo existente (lembrete padrao)\n  if (preenchidas >= esperadas) continue;   // completo: nada a lembrar\n  const t = trackingPorDeal.get(dealId) || {};\n  if (t.revisao_manual_parcial_em && String(t.revisao_manual_parcial_em).trim() !== '') continue; // ja escalado\n  const tentativas = Number(t.tentativas_parcial) || 0;\n  const datas = linhas.map(r => new Date(r.preenchido_em)).filter(d => !isNaN(d));\n  if (t.lembrete_parcial_enviado_em) { const d = new Date(t.lembrete_parcial_enviado_em); if (!isNaN(d)) datas.push(d); }\n  if (!datas.length) continue;\n  const referencia = new Date(Math.max(...datas.map(d => d.getTime())));\n  const dias = (agora - referencia) / (1000 * 60 * 60 * 24);\n  if (dias < DIAS_LEMBRETE) continue;\n  const base = {\n    deal_id: dealId, razao_social: lead.razao_social || '', email: lead.email || '',\n    lojas_esperadas: esperadas, lojas_preenchidas: preenchidas, lojas_faltantes: esperadas - preenchidas,\n    cnpjs_lista: cnpjs, cnpjs_texto: cnpjs.join(', '),\n    dias_desde_ultima_atividade: Math.floor(dias), tentativas_anteriores: tentativas,\n  };\n  if (tentativas >= MAX_TENTATIVAS) saida.push({ json: { ...base, acao: 'revisao_manual' } });\n  else saida.push({ json: { ...base, acao: 'lembrete_parcial', tentativa: tentativas + 1 } });\n}\nreturn saida.length ? saida : [{ json: { acao: 'nada' } }];\n"
      },
      "id": "474643bb-3c01-4e37-beae-e891fbb0b91c"
    },
