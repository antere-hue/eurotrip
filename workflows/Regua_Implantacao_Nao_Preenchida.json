    {
      "parameters": {
        "jsCode": "// Reformata para conter SOMENTE deal_id + o campo do nivel enviado nesta rodada, para\n// TODOS os itens que passaram pelo ramo 'lembrete' (nao so o primeiro — usa .all(), nao .item,\n// porque este e um Code node em modo \"run once for all items\" e precisa cobrir todos os leads\n// processados nesta rodada, nao apenas um).\nconst items = $('Processar Lembretes Implantacao').all();\nreturn items.map(i => {\n  const out = { deal_id: i.json.deal_id };\n  if (i.json.nivel === 'd2') out.lembrete_d2_enviado_em = new Date().toISOString();\n  if (i.json.nivel === 'd5') out.lembrete_d5_enviado_em = new Date().toISOString();\n  return { json: out };\n});"
      },
