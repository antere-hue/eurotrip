        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  from: 'Fernanda Spahn <comercial@antere.com.br>',\n  to: [$('ML_02_processar_parciais').item.json.email || ''],\n  subject: 'Faltam ' + $('ML_02_processar_parciais').item.json.lojas_faltantes + ' de ' + $('ML_02_processar_parciais').item.json.lojas_esperadas + ' lojas: complete os dados de implantação',\n  html: `\n    <div style='font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; color: #1B1E27;'>\n      <div style='background-color: #3A34D6; padding: 32px 24px; text-align: center;'>\n        <h1 style='color: #F7F5F1; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.5px;'>Antere</h1>\n        <p style='color: #C7C6F5; margin: 8px 0 0; font-size: 13px; letter-spacing: 0.2px;'>Automação comercial, do caixa ao pagamento</p>\n      </div>\n      <div style='padding: 32px 24px; background-color: #ffffff; text-align: center;'>\n        <p style='font-size: 16px; line-height: 1.6;'>Recebemos os dados de <strong>${$('ML_02_processar_parciais').item.json.lojas_preenchidas} das suas ${$('ML_02_processar_parciais').item.json.lojas_esperadas} lojas</strong> de <strong>${$('ML_02_processar_parciais').item.json.razao_social}</strong>. Faltam <strong>${$('ML_02_processar_parciais').item.json.lojas_faltantes}</strong>.</p>\n        <p style='font-size: 14px; line-height: 1.6; color: #5B5F6B;'>CNPJs já recebidos: ${$('ML_02_processar_parciais').item.json.cnpjs_texto}</p>\n        <p style='font-size: 15px; line-height: 1.6;'>Para ativar todas as unidades, preencha o formulário uma vez para cada loja que falta, informando o CNPJ dela no campo <strong>CNPJ desta loja</strong>.</p>\n        <div style='margin: 28px 0;'>\n          <a href='https://tally.so/r/MeW5YY' style='background-color: #3A34D6; color: #ffffff; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: bold; display: inline-block;'>Preencher dados das lojas restantes</a>\n        </div>\n        <p style='font-size: 14px; line-height: 1.6; color: #5B5F6B;'>Assim que todas as lojas estiverem cadastradas, nosso time inicia a ativação.</p>\n      </div>\n      <div style='background-color: #F7F5F1; padding: 16px 24px; text-align: center;'>\n        <p style='font-size: 11px; color: #8B8F9C; margin: 0;'>Antere Tecnologia (F. de Carvalho Spahn Consultoria em Tecnologia da Informação LTDA)</p>\n      </div>\n    </div>\n  `,\n  tags: [\n    { name: 'deal_id', value: $('ML_02_processar_parciais').item.json.deal_id || 'sem_deal_id' },\n    { name: 'regua_nivel', value: 'parcial_' + $('ML_02_processar_parciais').item.json.tentativa }\n  ]\n}) }}",
        "options": {}
