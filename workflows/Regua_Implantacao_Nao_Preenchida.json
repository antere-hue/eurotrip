        "jsonBody": "={{ {\n  from: 'Fernanda Spahn <comercial@antere.com.br>',\n  to: [$('Processar Lembretes Implantacao').item.json.email || ''],\n  subject: ($('Processar Lembretes Implantacao').item.json.nivel === 'd5' ? 'Última chamada: ' : 'Lembrete: ') + 'complete os dados de implantação da sua conta',\n  html: `\n    <div style='font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; color: #1B1E27;'>\n      <div style='background-color: #3A34D6; padding: 32px 24px; text-align: center;'>\n        <h1 style='color: #F7F5F1; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.5px;'>Antere</h1>\n        <p style='color: #C7C6F5; margin: 8px 0 0; font-size: 13px; letter-spacing: 0.2px;'>Automação comercial, do caixa ao pagamento</p>\n      </div>\n      <div style='padding: 32px 24px; background-color: #ffffff; text-align: center;'>\n        <p style='font-size: 15px; line-height: 1.6; color: #DC2626; font-weight: 700; margin: 0 0 12px;'>${$('Processar Lembretes Implantacao').item.json.nivel === 'd5' ? 'Ainda faltam os dados de implantação da sua conta — não deixe a ativação atrasar.' : 'Ainda não recebemos os dados de implantação da sua conta.'}</p>\n        <p style='font-size: 16px; line-height: 1.6;'>Sua proposta para <strong>${$('Processar Lembretes Implantacao').item.json.razao_social}</strong> já foi aceita — falta só preencher os dados técnicos para colocar sua conta no ar.</p>\n        <div style='margin: 28px 0;'>\n          <a href='https://tally.so/r/MeW5YY' style='background-color: #3A34D6; color: #ffffff; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: bold; display: inline-block;'>Preencher dados de implantação</a>\n        </div>\n        <p style='font-size: 14px; line-height: 1.6; color: #5B5F6B;'>Leva poucos minutos — assim que enviar, nosso time já parte para a ativação.</p>\n      </div>\n      <div style='background-color: #F7F5F1; padding: 16px 24px; text-align: center;'>\n        <p style='font-size: 11px; color: #8B8F9C; margin: 0;'>Antere Tecnologia (F. de Carvalho Spahn Consultoria em Tecnologia da Informação LTDA)</p>\n      </div>\n    </div>\n  `,\n  tags: [\n    { name: 'deal_id', value: $('Processar Lembretes Implantacao').item.json.deal_id || 'sem_deal_id' },\n    { name: 'regua_nivel', value: $('Processar Lembretes Implantacao').item.json.nivel }\n  ]\n} }}",
