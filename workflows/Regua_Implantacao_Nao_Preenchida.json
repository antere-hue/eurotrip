    {
      "parameters": {
        "jsCode": "// Regua do Formulario de Implantacao nao preenchido (Parte 2.2)\nconst DIAS_LEMBRETE_1 = 2;\nconst DIAS_LEMBRETE_2 = 5;\n\nfunction normalizarCnpj(v) { return String(v || '').replace(/\\D/g, ''); }\n\nconst logs = $('Buscar Log Implantacao Pendente').all().map(i => i.json);\nconst adquirentes = $('Buscar Dados Adquirentes').all().map(i => i.json);\nconst pix = $('Buscar Dados Pix').all().map(i => i.json);\nconst baseFunil = $('Buscar Base Funil Completo').all().map(i => i.json);\nconst tracking = $('Buscar Tracking Regua Implantacao').all().map(i => i.json);\n\nconst cnpjsComDados = new Set(\n  [...adquirentes, ...pix].map(r => normalizarCnpj(r.cnpj)).filter(Boolean)\n);\nconst trackingPorDeal = new Map(tracking.map(t => [String(t.deal_id), t]));\nconst baseFunilPorLeadId = new Map(baseFunil.map(l => [String(l.lead_id), l]));\n\nconst agora = new Date();\nconst saida = [];\n\nfor (const log of logs) {\n  const concluido = log.concluido && String(log.concluido).trim() !== '';\n  if (concluido) continue;\n\n  const cnpjNorm = normalizarCnpj(log.cnpj);\n  if (cnpjNorm && cnpjsComDados.has(cnpjNorm)) continue;\n\n  const lead = baseFunilPorLeadId.get(String(log.deal_id));\n  if (!lead) continue;\n\n  const detectadoEm = new Date(log.marcado_em);\n  if (isNaN(detectadoEm)) continue;\n  const dias = (agora - detectadoEm) / (1000 * 60 * 60 * 24);\n\n  const t = trackingPorDeal.get(String(log.deal_id)) || {};\n  const d2Enviado = t.lembrete_d2_enviado_em && String(t.lembrete_d2_enviado_em).trim() !== '';\n  const d5Enviado = t.lembrete_d5_enviado_em && String(t.lembrete_d5_enviado_em).trim() !== '';\n\n  // D+5 e a escalada final: se ja foi enviado, nao ha mais lembrete a mandar,\n  // mesmo que o D+2 nunca tenha sido registrado (ex.: regua fora do ar por alguns dias\n  // e o lead pulou direto para o limiar de 5 dias).\n  let nivel = null;\n  if (dias >= DIAS_LEMBRETE_2) {\n    if (!d5Enviado) nivel = 'd5';\n  } else if (dias >= DIAS_LEMBRETE_1 && !d2Enviado) {\n    nivel = 'd2';\n  }\n  if (!nivel) continue;\n\n  saida.push({ json: {\n    acao: 'lembrete',\n    nivel,\n    deal_id: log.deal_id,\n    razao_social: lead.razao_social || '',\n    email: lead.email || '',\n  }});\n}\n\nreturn saida.length ? saida : [{ json: { acao: 'nada' } }];"
      },
      "id": "a7480f88-bc33-40c3-a9b6-9735859d38ef",
      "name": "Processar Lembretes Implantacao",
