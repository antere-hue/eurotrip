      "parameters": {
        "jsCode": "// Lead do atendimento IA: nome obrigatorio + pelo menos um contato (e-mail ou telefone)\nconst inp = $input.first().json || {};\nconst clean = v => (v === undefined || v === null || String(v).toLowerCase() === 'null' || String(v).toLowerCase() === 'undefined') ? '' : String(v).trim();\nconst nome = clean(inp.nome);\nlet email = clean(inp.email).toLowerCase();\nif (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) email = '';\nlet telefone = clean(inp.telefone).replace(/\\D/g, '');\nconst telConversa = clean(inp.telefone_conversa).replace(/\\D/g, '');\nif (!telefone) telefone = telConversa;\nif (telefone && telefone.length <= 11) telefone = '55' + telefone;\nconst faltas = [];\nif (!nome) faltas.push('nome');\nif (!email && !telefone) faltas.push('e-mail ou telefone');\nreturn [{ json: { ok: faltas.length === 0, faltas, nome, email, telefone, telefone_conversa: telConversa, tem_email: !!email, interesse: clean(inp.interesse), origem: 'Lead WhatsApp IA' } }];"
      },
