    {
      "name": "06_vincula_fonte_rd",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        -100
      ],
      "parameters": {
        "jsCode": "// Vincula a fonte \"Lead WhatsApp IA\" ao deal (deals ignoram 'source' string; precisa de source_id). Erros aqui nao interrompem.\n// dados do lead vem do IF (a entrada deste node e a linha de token)\nconst j = $('05_if_lead_ok').first().json; const token = $input.first().json.access_token;\nconst base = 'https://api.rd.services/crm/v2'; const H = { Authorization: 'Bearer ' + token, Accept: 'application/json', 'Content-Type': 'application/json' };\nconst norm = x => String(x || '').normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();\nlet sourceId = ''; let fonte = 'nao_vinculada';\ntry {\n  const r = await this.helpers.httpRequest({ method: 'GET', url: base + '/sources?limit=100', headers: H, json: true });\n  const hit = ((r && r.data) || []).find(f => norm(f.name) === norm('Lead WhatsApp IA'));\n  if (hit && hit.id) sourceId = hit.id;\n  if (!sourceId) { const cr = await this.helpers.httpRequest({ method: 'POST', url: base + '/sources', headers: H, body: { data: { name: 'Lead WhatsApp IA' } }, json: true }); sourceId = (cr && cr.data && cr.data.id) || ''; }\n  if (sourceId) { await this.helpers.httpRequest({ method: 'PUT', url: base + '/deals/' + j.lead_id, headers: H, body: { data: { source_id: sourceId } }, json: true }); fonte = 'vinculada'; }\n} catch (e) { fonte = 'erro: ' + String(e.message || e).slice(0, 120); }\nreturn [{ json: { ...j, source_id: sourceId, fonte_rd: fonte } }];"
      },
