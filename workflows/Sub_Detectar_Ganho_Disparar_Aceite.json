            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  from: 'Fernanda Spahn <comercial@antere.com.br>',\n  to: [$('Gerar Token de Aceite').item.json.contact_email || ''],\n  subject: 'Confirme aceite eletrônico da sua proposta comercial',\n  html: `\n    <div style='font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; color: #1B1E27;'>\n      <div style='background-color: #3A34D6; padding: 32px 24px; text-align: center;'>\n        <h1 style='color: #F7F5F1; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.5px;'>Antere</h1>\n        <p style='color: #C7C6F5; margin: 8px 0 0; font-size: 13px; letter-spacing: 0.2px;'>Automação comercial, do caixa ao pagamento</p>\n      </div>\n      <div style='padding: 32px 24px; background-color: #ffffff; text-align: center;'>\n        <p style='font-size: 16px; line-height: 1.6;'>Sua proposta para <strong>${$('Gerar Token de Aceite').item.json.razao_social}</strong> está pronta para ser formalizada.</p>\n        <div style='margin: 28px 0;'>\n          <a href='https://raregoat-n8n.cloudfy.live/webhook/aceite-proposta?token=${$('Gerar Token de Aceite').item.json.token_aceite}' style='background-color: #3A34D6; color: #ffffff; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: bold; display: inline-block;'>Confirmar aceite</a>\n        </div>\n        <p style='font-size: 14px; line-height: 1.6; color: #5B5F6B;'>Depois de confirmar, você recebe os próximos passos por e-mail.</p>\n      </div>\n      <div style='background-color: #F7F5F1; padding: 16px 24px; text-align: center;'>\n        <p style='font-size: 11px; color: #8B8F9C; margin: 0;'>Antere Tecnologia (F. de Carvalho Spahn Consultoria em Tecnologia da Informação LTDA)</p>\n      </div>\n    </div>\n  `,\n  tags: [\n    { name: 'lead_id', value: $('Gerar Token de Aceite').item.json.id || 'sem_lead_id' }\n  ]\n} }}",
        "options": {}
      },
      "notes": "ATUALIZADO: identidade visual e assunto alinhados ao padrão do projeto (header indigo #3A34D6, rodapé claro #F7F5F1, mesma estrutura de 18_email_proposta e dos e-mails de Aceite_Eletronico_Proposta). Assunto fixo 'Confirme aceite eletrônico da sua proposta comercial'. Corpo resumido: abertura + botão único + linha final sobre próximos passos."
    },
