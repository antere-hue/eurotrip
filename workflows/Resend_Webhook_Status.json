    {
      "parameters": {
        "jsCode": "// Valida a assinatura HMAC enviada pela Resend (padrão Svix)\nconst crypto = require('crypto');\n\nconst webhookItem = $('1 - Webhook Trigger').item.json;\nconst headers = webhookItem.headers;\nconst svixId = headers['svix-id'];\nconst svixTimestamp = headers['svix-timestamp'];\nconst svixSignature = headers['svix-signature'];\nconst rawBody = JSON.stringify(webhookItem.body);\n\n// Segredo lido do Google Sheets (nó 2), não hardcoded aqui\nconst secret = $('2 - Buscar Secret Resend').item.json.signing_secret;\n\nlet isValid = false;\nlet isRecent = false;\n\ntry {\n  const signedContent = `${svixId}.${svixTimestamp}.${rawBody}`;\n  const secretBytes = Buffer.from(secret.split('_')[1], 'base64');\n  const expectedSig = crypto.createHmac('sha256', secretBytes)\n    .update(signedContent).digest('base64');\n\n  const validSignatures = svixSignature.split(' ').map(s => s.split(',')[1]);\n  isValid = validSignatures.includes(expectedSig);\n\n  const timestampAge = Math.abs(Date.now() / 1000 - parseInt(svixTimestamp));\n  isRecent = timestampAge < 300; // 5 minutos\n} catch (e) {\n  isValid = false;\n}\n\nreturn {\n  json: {\n    ...webhookItem,\n    assinatura_valida: isValid && isRecent\n  }\n};"
      },
