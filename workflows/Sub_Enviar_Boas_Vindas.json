        "mode": "runOnceForAllItems",
        "jsCode": "const r = $('03_envia_email_resend').first().json || {};\nconst enviado = !!r.id && !r.error;\nreturn [{ json: { email: $('01_trigger').first().json.email, lead_id: $('06_recupera_lead_id').first().json.lead_id, enviado, resend_id: r.id || '', erro: enviado ? '' : String((r.error && (r.error.message || r.error)) || r.message || 'falha no envio') } }];"
