      "id": "0c262377-fa50-4c45-bbe0-791ea443f119",
      "name": "06_recupera_lead_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -120
      ],
      "parameters": {
        "jsCode": "// Recupera lead_id perdido: se ja veio preenchido, so repassa; senao, pega a negociacao mais recente do contato\nconst orig = $('01_trigger').item.json;\nlet leadId = orig.lead_id || '';\nif (!leadId && Array.isArray($json.data)) {\n  const deals = [...$json.data].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));\n  leadId = deals.length ? deals[0].id : '';\n}\nreturn { json: { nome: orig.nome, email: orig.email, lead_id: leadId } };"
      }
    }
