    {
      "parameters": {
        "jsCode": "// Handshake de verificação exigido pela Meta ao cadastrar o webhook.\nconst query = $('1a - Webhook Verificacao (GET)').item.json.query || {};\n\n// A Meta manda os parâmetros com ponto; o n8n também expõe com underscore.\n// Aceita as duas grafias para evitar falha de resolução de chave.\nconst mode = query['hub.mode'] || query['hub_mode'];\nconst token = query['hub.verify_token'] || query['hub_verify_token'];\nconst challenge = query['hub.challenge'] || query['hub_challenge'];\n\nconst tokenEsperado = $('1b - Buscar Verify Token').item.json.signing_secret;\n\nconst valido = (mode === 'subscribe' && token === tokenEsperado);\n\nreturn {\n  json: {\n    verificacao_valida: valido,\n    challenge: valido ? String(challenge) : 'forbidden'\n  }\n};"
      },
