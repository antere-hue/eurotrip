    {
      "parameters": {
        "jsCode": "// A Meta envia os eventos aninhados em entry[].changes[].value.statuses[]\n// Um único POST pode conter VÁRIOS eventos de status — por isso explodimos em itens.\n\nconst corpo = $input.item.json.corpo || {};\nconst saida = [];\n\nconst entries = corpo.entry || [];\n\nfor (const entry of entries) {\n  const changes = entry.changes || [];\n  for (const change of changes) {\n    const value = change.value || {};\n    const statuses = value.statuses || [];\n\n    for (const st of statuses) {\n      // Converte epoch (segundos) para ISO\n      const ts = st.timestamp\n        ? new Date(parseInt(st.timestamp) * 1000).toISOString()\n        : '';\n\n      // Erros só existem quando status = failed\n      const erro = (st.errors && st.errors[0]) || {};\n\n      saida.push({\n        json: {\n          message_id: st.id || '',\n          telefone: st.recipient_id || '',\n          evento: st.status || '',\n          timestamp: ts,\n          erro_codigo: erro.code ? String(erro.code) : '',\n          erro_titulo: erro.title || '',\n          erro_detalhe: (erro.error_data && erro.error_data.details) || erro.message || '',\n          conversa_tipo: (st.conversation && st.conversation.origin && st.conversation.origin.type) || '',\n          cobravel: st.pricing ? String(st.pricing.billable) : ''\n        }\n      });\n    }\n  }\n}\n\nreturn saida;"
      },
