    {
      "parameters": {
        "jsCode": "// Valida a assinatura HMAC-SHA256 enviada pela Meta no header X-Hub-Signature-256\n// Formato do header: sha256=<hash hexadecimal>\n\nconst crypto = require('crypto');\n\nconst webhookItem = $('2 - Webhook Eventos (POST)').item.json;\nconst headers = webhookItem.headers || {};\nconst assinaturaRecebida = headers['x-hub-signature-256'] || '';\n\n// App Secret lido do Google Sheets (nó 3), não hardcoded\nconst appSecret = $('3 - Buscar App Secret').item.json.signing_secret;\n\n// A Meta assina o corpo BRUTO da requisição\nconst rawBody = typeof webhookItem.body === 'string'\n  ? webhookItem.body\n  : JSON.stringify(webhookItem.body);\n\nlet assinaturaValida = false;\n\ntry {\n  const hashEsperado = 'sha256=' + crypto\n    .createHmac('sha256', appSecret)\n    .update(rawBody, 'utf8')\n    .digest('hex');\n\n  // Comparação em tempo constante evita timing attacks\n  const a = Buffer.from(assinaturaRecebida);\n  const b = Buffer.from(hashEsperado);\n  assinaturaValida = a.length === b.length && crypto.timingSafeEqual(a, b);\n} catch (e) {\n  assinaturaValida = false;\n}\n\n// Normaliza o corpo para objeto, independente de ter chegado como string\nconst corpo = typeof webhookItem.body === 'string'\n  ? JSON.parse(webhookItem.body)\n  : webhookItem.body;\n\nreturn {\n  json: {\n    assinatura_valida: assinaturaValida,\n    corpo: corpo\n  }\n};"
      },
      "id": "5513ff11-ac09-4d45-b8c7-c9082a32dba9",
