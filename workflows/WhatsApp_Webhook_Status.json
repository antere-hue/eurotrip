    {
      "parameters": {
        "jsCode": "const KEYWORDS = ['SAIR', 'PARAR', 'CANCELAR'];\n\nfunction normaliza(str) {\n  return String(str || '')\n    .normalize('NFD').replace(/[̀-ͯ]/g, '') // remove acentos (marcas diacriticas)\n    .toUpperCase()\n    .replace(/\\s+/g, ' ')\n    .trim();\n}\n\nfunction soDigitos(str) {\n  return String(str || '').replace(/\\D/g, '');\n}\n\n// Referências explícitas aos nós de origem -- 12 fica logo após o branch de\n// 9a_if_tipo_evento, então $json cru não é confiável aqui.\nconst mensagens = $('10 - Extrai Mensagens Recebidas').all().map(i => i.json);\nconst leads = $('11 - Busca Base Funil').all().map(i => i.json);\n\nconst leads_para_atualizar = [];\nconst log_entries = [];\nconst notif_entries = [];\n\nfor (const msg of mensagens) {\n  const textoNorm = normaliza(msg.texto);\n  const ehOptout = KEYWORDS.some(k => textoNorm.includes(k));\n\n  const telefoneMsg = soDigitos(msg.telefone);\n  const leadsEncontrados = leads.filter(l => soDigitos(l.telefone) === telefoneMsg && telefoneMsg !== '');\n\n  let acao;\n  if (ehOptout && leadsEncontrados.length > 0) {\n    acao = 'opt-out aplicado';\n    for (const lead of leadsEncontrados) {\n      leads_para_atualizar.push({\n        lead_id: lead.lead_id,\n        telefone: msg.telefone\n      });\n    }\n  } else if (ehOptout && leadsEncontrados.length === 0) {\n    acao = 'nao encontrado';\n  } else {\n    acao = 'sem acao';\n  }\n\n  const nomes = leadsEncontrados\n    .map(l => l.nome_contato || l.razao_social || '')\n    .filter(Boolean)\n    .join(', ');\n\n  log_entries.push({\n    timestamp: msg.timestamp,\n    telefone: msg.telefone,\n    texto_recebido: msg.texto,\n    acao_tomada: acao,\n    lead_encontrado: leadsEncontrados.length > 0,\n    lead_nome: nomes\n  });\n\n  notif_entries.push({\n    telefone: msg.telefone,\n    texto: msg.texto,\n    eh_optout: ehOptout,\n    acao: acao,\n    lead_nome: nomes || null,\n    lead_encontrado: leadsEncontrados.length > 0\n  });\n}\n\nreturn [{\n  json: { leads_para_atualizar, log_entries, notif_entries }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
