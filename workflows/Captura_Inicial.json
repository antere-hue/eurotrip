      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function pick(obj, ...candidates) {\n  for (const key of Object.keys(obj)) {\n    const clean = key.trim().toLowerCase();\n    if (candidates.includes(clean)) return obj[key];\n  }\n  return undefined;\n}\n\nconst nomeRaw = pick($json, 'nome') || '';\nconst nome = String(nomeRaw).trim();\nconst primeiro_nome = nome.split(' ')[0] || 'Cliente';\n\nconst telefoneRaw = pick($json, 'telefone', 'telefone contato') || '';\nconst digits = String(telefoneRaw).replace(/\\D/g, '');\nconst telefone = digits.startsWith('55') ? digits : (digits ? '55' + digits : '');\n\nconst email = pick($json, 'email') || '';\nconst origem = pick($json, 'origem') || 'indicacao';\nconst ref = pick($json, 'ref') || '';\n\nconst optinRaw = pick($json, 'comunicacoes', 'comunicações') || [];\nconst optin_whatsapp = Array.isArray(optinRaw) ? optinRaw.length > 0 : Boolean(optinRaw);\n\nreturn {\n  json: {\n    nome,\n    primeiro_nome,\n    email,\n    telefone,\n    origem,\n    ref,\n    capturado_em: $now.toISO(),\n    optin_whatsapp,\n    optin_whatsapp_data: optin_whatsapp ? $now.toISO() : '',\n    optin_whatsapp_texto: optin_whatsapp ? String(optinRaw[0] || '') : '',\n  }\n};"
      },
