        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  from: \"Fernanda Spahn <comercial@antere.com.br>\",\n  to: [$json.email],\n  subject: \"Tecnologia para o seu negócio vender mais — fale com a Antere\",\n  html: `\n    <div style=\"font-family: Arial, Helvetica, sans-serif; max-width: 600px; margin: 0 auto; color: #1B1E27;\">\n      <div style=\"background-color: #3A34D6; padding: 32px 24px; text-align: center;\">\n        <h1 style=\"color: #F7F5F1; margin: 0; font-size: 24px; font-weight: 700; letter-spacing: -0.5px;\">Antere</h1>\n        <p style=\"color: #C7C6F5; margin: 8px 0 0; font-size: 13px; letter-spacing: 0.2px;\">Automação comercial, do caixa ao pagamento</p>\n      </div>\n      <div style=\"padding: 32px 24px; background-color: #ffffff;\">\n        <p style=\"font-size: 16px; line-height: 1.6;\">Olá, <strong>${$json.primeiro_nome}</strong>!</p>\n        <p style=\"font-size: 16px; line-height: 1.6;\">Sou Fernanda Spahn, da Antere. Muito obrigada pelo seu contato — fico feliz em ajudar a levar mais tecnologia para o seu negócio.</p>\n        <p style=\"font-size: 16px; line-height: 1.6;\">Trabalhamos com uma plataforma completa que integra TEF, Gateway, Link de Pagamento e conta digital C6 Bank — tudo conectado ao seu sistema de vendas.</p>\n        <p style=\"font-size: 15px; line-height: 1.6; color: #5B5F6B;\">Na prática, isso significa:</p>\n        <ul style=\"font-size: 15px; line-height: 1.8; color: #5B5F6B; padding-left: 20px;\">\n          <li>Redução de erros de caixa com captura automática</li>\n          <li>Conciliação que sai de horas para minutos</li>\n          <li>Taxas competitivas e PIX gratuito e ilimitado</li>\n          <li>Implantação em até 10 dias úteis</li>\n        </ul>\n        <p style=\"font-size: 16px; line-height: 1.6; font-weight: bold; margin-top: 24px;\">Falta pouco para você ver sua proposta personalizada.</p>\n        <p style=\"font-size: 15px; line-height: 1.6;\">Leva menos de 2 minutos: preencha alguns dados sobre a sua operação e, em instantes, você recebe uma proposta automática com as condições ideais para o seu negócio.</p>\n        <div style=\"text-align: center; margin: 32px 0;\">\n          <a href=\"https://raregoat-n8n.cloudfy.live/form/proposta?lead_id=${$json.lead_id}\" style=\"background-color: #3A34D6; color: #ffffff; padding: 14px 32px; text-decoration: none; border-radius: 8px; font-size: 16px; font-weight: bold; display: inline-block;\">Quero minha proposta personalizada</a>\n        </div>\n        <p style=\"font-size: 14px; line-height: 1.6; color: #5B5F6B;\">Sem burocracia, sem precisar falar com ninguém — a menos que prefira.</p>\n        <hr style=\"border: none; border-top: 1px solid #E5E1D8; margin: 24px 0;\">\n        <p style=\"font-size: 14px; line-height: 1.6;\">Se preferir um atendimento personalizado, estou à disposição no WhatsApp:</p>\n        <p style=\"font-size: 14px; line-height: 1.6;\">📱 <a href=\"https://wa.me/5511993979324\" style=\"color: #12786B;\">(11) 99397-9324</a></p>\n        <p style=\"font-size: 14px; line-height: 1.6; margin-top: 24px;\">Abraço,<br><strong>Fernanda Spahn</strong><br>Consultoria Comercial — Antere</p>\n      </div>\n      <div style=\"background-color: #F7F5F1; padding: 16px 24px; text-align: center;\">\n        <p style=\"font-size: 11px; color: #8B8F9C; margin: 0;\">Antere Tecnologia (F. de Carvalho Spahn Consultoria em Tecnologia da Informação LTDA)</p>\n        <p style=\"font-size: 11px; color: #8B8F9C; margin: 4px 0 0;\">Seus dados serão usados exclusivamente para elaborar sua proposta comercial, conforme a LGPD.</p>\n      </div>\n    </div>\n  `,\n  tags: [\n    { name: \"lead_id\", value: $json.lead_id }\n  ]\n} }}",
        "options": {}
