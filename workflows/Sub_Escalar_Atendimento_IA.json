    },
    {
      "name": "Retorna",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const s=$input.first().json||{}; return [{ json: { ok: !!s.ok, mensagem: s.ok ? 'Equipe comercial avisada no Slack. Diga ao cliente que alguém responde neste WhatsApp em horário comercial.' : 'Não foi possível avisar a equipe agora; peça ao cliente para aguardar e tente de novo.' } }];"
      },
      "id": "272a8771-1ec1-4eca-ad3e-6d0c854355e3"
    },
    {
      "name": "Classifica Urgencia",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        200,
        -180
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "workflowId": {
          "__rl": true,
          "mode": "list",
          "value": "uyJdJRGS2VnVvPQo",
          "cachedResultName": "Sub_Classificar_Urgencia_WhatsApp"
        },
        "mode": "each",
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
