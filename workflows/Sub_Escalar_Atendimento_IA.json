      "typeVersion": 2,
      "position": [
        400,
        -180
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const base = $('Trigger').item.json;\nconst c = $json || {};\nreturn { json: { ...base, urgente: !!c.urgente, palavra_urgencia: c.palavra || '', prefixo: c.prefixo || '' } };"
      },
      "id": "3e0923a1-e3d0-4e80-b2a4-73b95132121e"
    }
